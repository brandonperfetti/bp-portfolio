{
  "name": "bp-portfolio",
  "version": "4.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "node scripts/local-server.mjs dev",
    "prepare": "husky",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest run --coverage --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "verify:readers": "node scripts/verify-reader-journeys.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "diff:pages": "node scripts/diff-pages.mjs",
    "storybook": "node scripts/local-server.mjs storybook",
    "build-storybook": "storybook build",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "db:local:refresh": "bash scripts/dev-db-restore.sh",
    "seed:e2e": "payload run scripts/seed-e2e.ts",
    "corvus:backfill": "payload run scripts/backfill-corvus-embeddings.ts",
    "corvus:sync-github": "payload run scripts/sync-github-repos.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "eval": "cd evals && evalite watch",
    "eval:ci": "cd evals && evalite run --threshold 80 --outputPath ./corvus-eval-run.json",
    "eval:facts": "cd evals && evalite run site-facts.eval.ts --threshold 75",
    "eval:matrix": "cd evals && CORVUS_EVAL_MATRIX=1 evalite run matrix.eval.ts --threshold 0 --outputPath ./corvus-matrix.json"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.100",
    "@ai-sdk/openai": "3.0.87",
    "@ai-sdk/react": "3.0.236",
    "@c15t/react": "2.2.1",
    "@c15t/scripts": "2.2.0",
    "@clerk/nextjs": "^7.10.2",
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-mcp": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-search": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@sentry/nextjs": "^10.78.0",
    "@tailwindcss/postcss": "^4.1.15",
    "@tailwindcss/typography": "^0.5.16",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "6.0.234",
    "c15t": "2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "feed": "^5.1.0",
    "graphql": "^16.14.2",
    "gsap": "^3.14.2",
    "lucide-react": "^1.25.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "okapibm25": "^1.4.1",
    "openai": "^5.12.2",
    "payload": "3.93.0",
    "radix-ui": "^1.6.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "shaders": "^3.0.442",
    "streamdown": "^2.5.0",
    "svix": "^1.98.0",
    "swiper": "^14.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/backend": "^3.30.0",
    "@playwright/test": "^1.58.2",
    "@spotlightjs/spotlight": "^4.12.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "autoevals": "^0.3.0",
    "esbuild": "0.28.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-tsdoc": "^0.5.2",
    "evalite": "^0.19.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.23.4 || >=24.22.1 <25"
  }
}
