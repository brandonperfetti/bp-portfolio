# =============================================================================
# BP Portfolio v4 — environment variables
# Copy to `.env` for local dev. Brandon populates real secrets in Vercel
# (per-environment) and GitHub Actions as each phase lands.
# =============================================================================

# --- Core / site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Brandon Perfetti

# --- Payload CMS (new in v4) ---
# Secret used to sign Payload auth tokens. Generate: `openssl rand -hex 32`.
PAYLOAD_SECRET=
# Postgres connection string (pooled for serverless; Vercel Postgres in
# staging/prod, local Postgres in dev). On Vercel this can be omitted —
# a connected Postgres store auto-injects POSTGRES_URL, which is accepted
# as a fallback.
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/bp_portfolio_dev
# Vercel Blob media storage (replaces Cloudinary). Leave empty locally to
# fall back to local file storage.
BLOB_READ_WRITE_TOKEN=
# Set to "true" ONLY for local dev schema push experiments; staging/prod use
# committed migrations (`pnpm migrate`).
PAYLOAD_DB_PUSH=false
# Payload MCP (plugin-mcp) API key for Claude-driven content ops (Phase 1).
PAYLOAD_MCP_API_KEY=

# --- Clerk (end-user auth, gating, email capture — Phase 5) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- AI (Hermes — Phase 4) ---
OPENAI_API_KEY=
# Optional: run Hermes on Claude models instead.
ANTHROPIC_API_KEY=
# Provider + model selection without code changes.
AI_CHAT_PROVIDER=openai
AI_CHAT_MODEL=
AI_MAX_COMPLETION_TOKENS=1024
# Guardrail kill switches.
HERMES_DISABLE_CHAT=false
# Per-IP daily chat quota (0 = unlimited).
HERMES_CHAT_DAILY_QUOTA=200
HERMES_DISABLE_IMAGE=false
# Rate limiting (global store — required in staging/prod for cross-instance
# limits; in-memory fallback is dev-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional Cloudflare Turnstile bot protection (widget + verification ship
# env-gated; without keys, both surfaces behave as if Turnstile didn't
# exist). Setting the key pair ENFORCES verification on /api/contact.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Chat is armed separately (rollout decision 2026-08-10): flip BOTH flags
# to 'true' to require Turnstile on /api/ai/chat. Keep the pair in
# lockstep — server-on/client-off rejects every chat message.
TURNSTILE_PROTECT_CHAT=
NEXT_PUBLIC_TURNSTILE_PROTECT_CHAT=

# --- Resend (contact form delivery + Payload transactional + Clerk email
# capture; replaced SendGrid 2026-08-10) ---
RESEND_API_KEY=
# Segment that captured sign-up emails land in (Clerk webhook). Optional —
# without it, contacts are still created, just unsegmented.
RESEND_CONTACT_SEGMENT_ID=
# From/to addresses; the from must belong to a Resend-verified domain.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Revalidation / integrations ---
# Secret gating /api/revalidate (on-demand ISR).
CMS_REVALIDATE_SECRET=
# Read-only GitHub token for /tech live signals (higher rate limits).
GITHUB_TOKEN=
# GitHub account scanned for /tech live signals.
GITHUB_OWNER=brandonperfetti
# Optional tech-signal scan knobs (defaults shown; see techSignals.ts).
# GITHUB_TECH_REPO_LIMIT=60
# GITHUB_TECH_MAX_REPO_AGE_MONTHS=24
# GITHUB_TECH_INCLUDE_PRIVATE=false
# GITHUB_TECH_REPOS_ALLOWLIST=
# GITHUB_TECH_REPOS_DENYLIST=

# --- Removed in v4 (do not re-add) ---
# All NOTION_* vars (~30), all Cloudinary vars, CRON_SECRET and Notion
# webhook/cron secrets: the Notion-as-CMS automation platform is retired.

# Draft preview (admin Live Preview / Preview button)
PREVIEW_SECRET=
