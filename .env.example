# =============================================================================
# BP Portfolio v4 — environment variables
# Copy to `.env` for local dev. Brandon populates real secrets in Vercel
# (per-environment) and GitHub Actions as each phase lands.
# =============================================================================

# --- Core / site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Brandon Perfetti

# --- Payload CMS (new in v4) ---
# Secret used to sign Payload auth tokens. Generate: `openssl rand -hex 32`.
PAYLOAD_SECRET=
# Postgres connection string (Supabase in staging/prod, local Postgres in
# dev). Use the SUPAVISOR TRANSACTION-MODE pooler string (port 6543) for
# the app — serverless needs transient connections; pg_dump/restore uses
# the session-mode string (5432). POSTGRES_URL / DATABASE_URL are accepted
# as fallbacks.
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/bp_portfolio_dev
# Vercel Blob media storage (replaces Cloudinary). Leave empty locally to
# fall back to local file storage.
BLOB_READ_WRITE_TOKEN=
# Set to "true" ONLY for local dev schema push experiments; staging/prod use
# committed migrations (`pnpm migrate`).
PAYLOAD_DB_PUSH=false
# Payload MCP (plugin-mcp) API key for Claude-driven content ops (Phase 1).
PAYLOAD_MCP_API_KEY=

# --- Clerk (end-user auth, gating, email capture — Phase 5) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Keep sign-up/sign-in navigation (and the email-code verification step,
# part of the same sign-up flow) on the app's own themed /sign-in and
# /sign-up routes instead of falling back to Clerk's unstyled hosted
# Account Portal (#96). The <SignIn>/<SignUp> components also pin
# path/routing/signInUrl/signUpUrl explicitly, so this works even if left
# unset here — set it anyway so any other Clerk-generated link (e.g. from
# the Dashboard) resolves in-app too.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- AI (Corvus — Phase 4) ---
OPENAI_API_KEY=
# Optional: run Corvus on Claude models instead.
ANTHROPIC_API_KEY=
# Optional OpenAI-compatible endpoint. Leave EMPTY unless you genuinely proxy
# OpenAI (Azure, an internal gateway, a record/replay cache) — @ai-sdk/openai
# already defaults to the public API. It is listed because the eval harness
# pins it: autoevals' Factuality grader reads this same variable and, unset,
# defaults to Braintrust's gateway, which 401s an OpenAI key. See
# evals/openai-base-url.ts. A value set here wins on both paths.
OPENAI_BASE_URL=
# Provider + model selection without code changes.
AI_CHAT_PROVIDER=openai
AI_CHAT_MODEL=
AI_MAX_COMPLETION_TOKENS=1024
# Guardrail kill switches. (Renamed from HERMES_* per #77.)
CORVUS_DISABLE_CHAT=false
# Per-IP daily chat quota (0 = unlimited).
CORVUS_CHAT_DAILY_QUOTA=200
# Auth soft-gate (#74, folds #18): anonymous visitors get this many free
# messages (cumulative per-IP, Upstash-backed) before the chat route
# responds with a sign-in-required state instead of streaming. Default 3.
CORVUS_ANON_FREE_MESSAGES=3
# Signed-in ceilings — apply once a visitor has a Clerk session (keyed by
# userId instead of IP), replacing CORVUS_CHAT_RATE_LIMIT_PER_MINUTE /
# CORVUS_CHAT_DAILY_QUOTA for that request. Defaults: 30/min, 1000/day.
CORVUS_CHAT_RATE_LIMIT_PER_MINUTE_AUTHED=30
CORVUS_CHAT_DAILY_QUOTA_AUTHED=1000
CORVUS_DISABLE_IMAGE=false
# --- Retrieval grounding (#82) ---
# Corvus answers site-specific questions from a pgvector index over published
# content (`corvus_embeddings`), refreshed by collection hooks. Embeddings are
# their OWN provider axis, NOT derived from AI_CHAT_PROVIDER: @ai-sdk/anthropic
# ships no embedding model, so flipping chat to Claude must not take the index
# down with it. Only "openai" is supported; anything else fails loudly.
AI_EMBEDDING_PROVIDER=openai
# Supported: text-embedding-3-small (default) | text-embedding-3-large.
# text-embedding-ada-002 is deliberately unsupported — it cannot accept the
# explicit `dimensions` option this pipeline always sends.
AI_EMBEDDING_MODEL=text-embedding-3-small
# Assertion + documentation, not a free knob: the width is baked into the DDL
# (`vector(1536)`), so actually changing it needs a new migration. The write
# path always sends this as an explicit `dimensions` provider option and fails
# loudly if a returned vector is a different width — which is what lets
# text-embedding-3-large be swapped in above with no schema change.
AI_EMBEDDING_DIMENSIONS=1536
# How many retrieved passages are appended to the system prompt per turn. This
# is the recurring cost knob (~2k extra input tokens/turn at 5); start low.
CORVUS_RETRIEVAL_TOP_K=5
# Kill switch, same "empty var ⇒ zero code" idiom as the switches above: set to
# exactly "true" to short-circuit retrieval BEFORE the embedding call and the
# database round-trip. Chat then behaves exactly as it did pre-#82 — the
# ungrounded system prompt is byte-identical, not merely similar.
CORVUS_DISABLE_RETRIEVAL=
# Rate limiting (global store — required in staging/prod for cross-instance
# limits; in-memory fallback is dev-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional Cloudflare Turnstile bot protection (widget + verification ship
# env-gated; without keys, both surfaces behave as if Turnstile didn't
# exist). Setting the key pair ENFORCES verification on /api/contact.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Chat is armed separately (rollout decision 2026-08-10): flip BOTH flags
# to 'true' to require Turnstile on /api/ai/chat. Keep the pair in
# lockstep — server-on/client-off rejects every chat message.
TURNSTILE_PROTECT_CHAT=
NEXT_PUBLIC_TURNSTILE_PROTECT_CHAT=

# --- Resend (contact form delivery + Payload transactional + Clerk email
# capture; replaced SendGrid 2026-08-10) ---
RESEND_API_KEY=
# Segment that captured emails land in (Clerk sign-up webhook + the
# contact form's explicit opt-in checkbox). Optional — without it,
# contacts are still created, just unsegmented.
RESEND_CONTACT_SEGMENT_ID=
# From/to addresses; the from must belong to a Resend-verified domain.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Sentry (error monitoring — #73) ---
# Entirely env-gated: leave every var below empty and zero Sentry code
# paths run (local dev/CI boot exactly as before). Set at least the client
# DSN to turn Sentry on everywhere (server/edge fall back to it).
# DSN for browser events (safe to expose — DSNs aren't secret, that's why
# this one is NEXT_PUBLIC_).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: separate DSN for server/edge events. Falls back to
# NEXT_PUBLIC_SENTRY_DSN when unset, so most deployments only need the one
# var above.
SENTRY_DSN=
# CI/Vercel-build-only secret for uploading source maps (never needed at
# runtime; keep it out of the Vercel "Preview"/browser-exposed scope).
SENTRY_AUTH_TOKEN=
# Org + project slugs the Vercel integration/build plugin uploads
# source maps to.
SENTRY_ORG=
SENTRY_PROJECT=
# Optional: override the environment tag Sentry attaches to events. Must
# be NEXT_PUBLIC_-prefixed to reach the browser bundle (server/edge read
# it fine either way) — set per Vercel environment (development/staging/
# production). Defaults to VERCEL_ENV, then NODE_ENV, then "development".
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: performance tracing sample rate, 0-1. Defaults to a
# conservative 0.1; errors are always captured regardless of this value.
SENTRY_TRACES_SAMPLE_RATE=

# --- Consent & analytics (headless c15t + GA4 — #83) ---
# GA4 measurement ID, gated behind consent (Consent Mode v2), alongside the
# always-on cookieless Vercel Analytics. Entirely env-gated: leave empty and
# ZERO Google code is registered (no gtag.js, no dataLayer) — mirrors the
# Sentry/Turnstile "empty var ⇒ zero code" idiom. Production-only: GA4 loads
# only when NEXT_PUBLIC_VERCEL_ENV === 'production' (Vercel-injected + client
# readable — NOT NODE_ENV, which is 'production' on Preview builds too). Set the
# ID in the Vercel *Production* environment; leave it empty in Preview/local.
# Safe to expose (NEXT_PUBLIC_) — the measurement ID is a public client
# identifier, not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_VERCEL_ENV is provided automatically by Vercel (no value to set
# here; it is 'production' | 'preview' | 'development'). Consent geo is decided
# in src/proxy.ts from Vercel's ambient edge headers (x-vercel-ip-country /
# -country-region) and written to a `cookieConsentRequired` cookie — NO backend
# service and NO new env var. c15t runs headless (offline, client-side).

# --- Revalidation / integrations ---
# Secret gating /api/revalidate (on-demand ISR).
CMS_REVALIDATE_SECRET=
# Read-only GitHub token for /tech live signals (higher rate limits).
GITHUB_TOKEN=
# GitHub account scanned for /tech live signals.
GITHUB_OWNER=brandonperfetti
# Optional tech-signal scan knobs (defaults shown; see techSignals.ts).
# GITHUB_TECH_REPO_LIMIT=60
# GITHUB_TECH_MAX_REPO_AGE_MONTHS=24
# GITHUB_TECH_INCLUDE_PRIVATE=false
# GITHUB_TECH_REPOS_ALLOWLIST=
# GITHUB_TECH_REPOS_DENYLIST=

# --- Removed in v4 (do not re-add) ---
# All NOTION_* vars (~30), all Cloudinary vars, CRON_SECRET and Notion
# webhook/cron secrets: the Notion-as-CMS automation platform is retired.

# Draft preview (admin Live Preview / Preview button)
PREVIEW_SECRET=
