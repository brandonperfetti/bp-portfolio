# Two kinds of push run no gate. Git lists each pushed ref on stdin as
# "<local ref> <local sha> <remote ref> <remote sha>".
#
# - A deletion (an all-zero local sha) sends no code, so there is nothing to
#   gate (#308).
# - A tag (remote ref under refs/tags/) moves no branch: no workflow here
#   runs on a tag, nothing deploys from one, and no PR reads one. A release
#   tag names a commit already on master, which CI gated in full (#369). The
#   commits a tag carries are gated when a branch that holds them is pushed.
#
# Skip only when at least one ref was listed and every one is a deletion or a
# tag; an empty list or any branch in the push runs the full gate below.
# Pinned by scripts/pre-push-hook.test.ts.
only_deletions_or_tags() {
  listed=0
  while read -r _local_ref local_sha remote_ref _rest || [ -n "$local_sha" ]; do
    [ -z "$local_sha" ] && continue
    listed=1
    case "$local_sha" in
      *[!0]*) ;;
      *) continue ;;
    esac
    case "$remote_ref" in
      refs/tags/?*) ;;
      *) return 1 ;;
    esac
  done
  [ "$listed" -eq 1 ]
}

if only_deletions_or_tags; then
  echo "pre-push: this push only deletes refs or pushes tags, so the gate is skipped."
  exit 0
fi

