# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
/.swc

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files: every .env* file stays out of git, in any case and at any
# depth, except the documented example at the root (#261). Pinned by
# scripts/env-files-ignored.test.ts.
.[eE][nN][vV]*
!/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated files
public/sitemap.xml

# ESLint cache
.eslintcache

# local tooling artifacts
/.playwright-cli
/output
/playwright-report
/test-results

# uploads written by the local seed (`pnpm seed:e2e`, #356)
/media/

# temporary files
.tmp*
# migration run artifacts (one-off reconciliation output, not source)
scripts/migration-report.json
storybook-static
